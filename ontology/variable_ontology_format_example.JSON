    "ScaleValue": [
        {
            "label": "VE",
            "description": "Emergence - shoot (coleoptile) has emerged from the soil",
            "order": 1,
            "scale_id": "maize growth stage"
        },
        {
            "label": "V1",
            "description": "First leaf - lowest leaf has a visible collar; this leaf has a rounded tip",
            "order": 2,
            "scale_id": "maize growth stage"
        },
        {
            "label": "V2",
            "description": "Second leaf - two of the lowest leaves have a visible collar, the second and subsequent leaves have pointed tips",
            "order": 3,
            "scale_id": "maize growth stage"
        },
        {
            "label": "V3",
            "description": "Third leaf - 3 leaf collars present.",
            "order": 4,
            "scale_id": "maize growth stage"
        },
        {
            "label": "V4",
            "description": "Fourth leaf - 4 leaf collars present.",
            "order": 5,
            "scale_id": "maize growth stage"
        },
        {
            "label": "V5",
            "description": "Fifth leaf - 5 leaf collars present.",
            "order": 6,
            "scale_id": "maize growth stage"
        },
        {
            "label": "V6",
            "description": "Sixth leaf - 6 leaf collars present.",
            "order": 7,
            "scale_id": "maize growth stage"
        },
        {
            "label": "V7",
            "description": "Seventh leaf - 7 leaf collars present.",
            "order": 8,
            "scale_id": "maize growth stage"
        },
        {
            "label": "V8",
            "description": "Eighth leaf - 8 leaf collars present.",
            "order": 9,
            "scale_id": "maize growth stage"
        },
        {
            "label": "V9",
            "description": "Ninth leaf - 9 leaf collars present.",
            "order": 10,
            "scale_id": "maize growth stage"
        },
        {
            "label": "VT",
            "description": "Tassel - lowest branch of the tassel is visible",
            "order": 11,
            "scale_id": "maize growth stage"
        },
        {
            "label": "R1",
            "description": "Silk - one or more silks extends outside of husk leaves",
            "order": 12,
            "scale_id": "maize growth stage"
        },
        {
            "label": "R2",
            "description": "Blister - kernels resemble “blisters” with clear liquid",
            "order": 13,
            "scale_id": "maize growth stage"
        },
        {
            "label": "R3",
            "description": "Milk - kernels filled with “milky” fluid",
            "order": 14,
            "scale_id": "maize growth stage"
        },
        {
            "label": "R4",
            "description": "Dough - inside the kernels are a “doughy” consistency",
            "order": 15,
            "scale_id": "maize growth stage"
        },
        {
            "label": "R5",
            "description": "Dent - dent forms on kernel and milk line progresses towards kernel tip",
            "order": 16,
            "scale_id": "maize growth stage"
        },
        {
            "label": "R6",
            "description": "Physiological maturity – kernels at maximum dry matter accumulation; a “black layer” will form at kernel base (2-3 days after physiological maturity)",
            "order": 17,
            "scale_id": "maize growth stage"
        }
